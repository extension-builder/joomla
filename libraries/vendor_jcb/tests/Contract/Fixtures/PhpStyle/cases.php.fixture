<?php
final class PassingFixture
{
	public function render(string $method): string
	{
		$literal = 'first
    literal indentation is preserved';
		$generated = <<<'TEXT'
    generated indentation is preserved
TEXT;
    // Comment indentation is not structural PHP indentation.

		return $this->{$method}($literal . $generated);
		return self::{$method}($literal . $generated);
	}
}
PHP
		. "\n",
