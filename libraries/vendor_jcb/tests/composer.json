{
	"name": "vdm-io/joomla-component-builder-tests",
	"description": "Unit-test harness for the Joomla Component Builder vendor libraries.",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": "^8.3"
	},
	"require-dev": {
		"algo26-matthias/idna-convert": "^4.2.1",
		"altcha-org/altcha": "^1.3.2",
		"composer/ca-bundle": "^1.5.10",
		"defuse/php-encryption": "^2.4.0",
		"doctrine/inflector": "^2.1.0",
		"dragonmantank/cron-expression": "^3.6.0",
		"enshrined/svg-sanitize": "^0.22.0",
		"fig/link-util": "^1.2.0",
		"google/recaptcha": "^1.3.1",
		"jfcherng/php-diff": "^6.16.2",
		"joomla/application": "^4.0",
		"joomla/archive": "^4.0",
		"joomla/authentication": "^4.0",
		"joomla/console": "^4.0",
		"joomla/crypt": "^4.0",
		"joomla/data": "^4.0",
		"joomla/database": "^4.0",
		"joomla/di": "^4.0",
		"joomla/event": "^4.0",
		"joomla/filesystem": "^4.1",
		"joomla/filter": "4.0.2",
		"joomla/http": "^4.0",
		"joomla/input": "^4.0",
		"joomla/language": "^4.0",
		"joomla/oauth1": "^4.0",
		"joomla/oauth2": "^4.0",
		"joomla/registry": "^4.0",
		"joomla/router": "^4.0",
		"joomla/session": "^4.0",
		"joomla/string": "^4.0",
		"joomla/uri": "^4.0",
		"joomla/utilities": "^4.0",
		"laminas/laminas-diactoros": "^3.8.0",
		"lcobucci/jwt": "^4.3.0",
		"paragonie/sodium_compat": "^1.24.0",
		"php-debugbar/php-debugbar": "^2.2.6",
		"php-tuf/php-tuf": "^1.0.3",
		"phpmailer/phpmailer": "^6.12.0",
		"phpseclib/bcmath_compat": "^2.0.3",
		"psr/link": "~1.1.1",
		"psr/log": "^3.0.2",
		"phpunit/phpunit": "^12.5",
		"symfony/console": "^7",
		"symfony/error-handler": "^7",
		"symfony/ldap": "^7",
		"symfony/options-resolver": "^7",
		"symfony/polyfill-mbstring": "^1.33.0",
		"symfony/web-link": "^6.4.32",
		"symfony/yaml": "^6.4.34",
		"tobscure/json-api": "dev-joomla-backports",
		"wamania/php-stemmer": "^4.0.0",
		"web-token/jwt-library": "^3.4.10",
		"willdurand/negotiation": "^3.1.0"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/joomla-backports/json-api-php.git",
			"no-api": true
		},
		{
			"type": "vcs",
			"url": "https://github.com/joomla-backports/php-tuf.git",
			"no-api": true
		}
	],
	"autoload": {
		"psr-4": {
			"Joomla\\CMS\\": ".runtime/joomla-cms/libraries/src/",
			"VDM\\Joomla\\Github\\": "../VDM.Joomla.Github/src/",
			"VDM\\Joomla\\Openai\\": "../VDM.Joomla.Openai/src/",
			"VDM\\Joomla\\Gitea\\": "../VDM.Joomla.Gitea/src/",
			"VDM\\Joomla\\Git\\": "../VDM.Joomla.Git/src/",
			"VDM\\Joomla\\FOF\\": "../VDM.Joomla.FOF/src/",
			"VDM\\Joomla\\": "../VDM.Joomla/src/",
			"VDM\\Minify\\": "../VDM.Minify/src/",
			"VDM\\Psr\\": "../VDM.Psr/src/",
			"VDM\\Component\\Componentbuilder\\Administrator\\": "../../../admin/src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"VDM\\Joomla\\Github\\Tests\\": "VDM.Joomla.Github/src/",
			"VDM\\Joomla\\Openai\\Tests\\": "VDM.Joomla.Openai/src/",
			"VDM\\Joomla\\Gitea\\Tests\\": "VDM.Joomla.Gitea/src/",
			"VDM\\Joomla\\Git\\Tests\\": "VDM.Joomla.Git/src/",
			"VDM\\Joomla\\Tests\\": "VDM.Joomla/src/",
			"VDM\\Minify\\Tests\\": "VDM.Minify/src/",
			"VDM\\Tests\\Contract\\": "Contract/",
			"VDM\\Tests\\Support\\": "Support/"
		}
	},
	"scripts": {
		"test": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --exclude-group known-defect --no-coverage",
		"test:coverage": [
			"@php -r \"is_dir('build/coverage') || mkdir('build/coverage', 0700, true);\"",
			"@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --exclude-group known-defect --coverage-clover build/coverage/clover.xml --coverage-text --only-summary-for-coverage-text"
		],
		"test:known-defects": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --group known-defect --no-coverage",
		"test:joomla": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite VDM.Joomla --exclude-group known-defect --no-coverage",
		"test:gitea": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite VDM.Joomla.Gitea --exclude-group known-defect --no-coverage",
		"test:openai": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite VDM.Joomla.Openai --exclude-group known-defect --no-coverage",
		"test:github": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite VDM.Joomla.Github --exclude-group known-defect --no-coverage",
		"test:minify": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite VDM.Minify --exclude-group known-defect --no-coverage",
		"test:git": "@php -d memory_limit=1G vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite VDM.Joomla.Git --exclude-group known-defect --no-coverage"
	},
	"config": {
		"optimize-autoloader": true,
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
